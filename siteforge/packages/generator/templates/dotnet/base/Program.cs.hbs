using Api.Data;
using Api.Endpoints;
using Microsoft.EntityFrameworkCore;
{{#if auth}}
using Api.Models;
using Microsoft.AspNetCore.Identity;
{{/if}}

var builder = WebApplication.CreateBuilder(args);

builder.Services.AddDbContext<AppDbContext>(options =>
    options.UseSqlite(builder.Configuration.GetConnectionString("Default")));

builder.Services.AddCors(options =>
    options.AddDefaultPolicy(policy => policy.AllowAnyOrigin().AllowAnyHeader().AllowAnyMethod()));

builder.Services.AddEndpointsApiExplorer();
builder.Services.AddSwaggerGen();
{{#if auth}}
builder.Services.AddSingleton<PasswordHasher<User>>();
{{/if}}

var app = builder.Build();

app.UseCors();
// The template ships a wwwroot/ folder, but make sure it exists even if the
// user deleted it: otherwise ASP.NET Core logs "The WebRootPath was not
// found ... Static files may be unavailable." and uploaded /media images 404.
Directory.CreateDirectory(Path.Combine(app.Environment.ContentRootPath, "wwwroot"));
app.UseStaticFiles();

if (app.Environment.IsDevelopment())
{
    app.UseSwagger();
    app.UseSwaggerUI();
}

app.MapPageEndpoints();
{{#if isPersonal}}
app.MapContentEndpoints();
{{/if}}
{{#if isBusiness}}
app.MapContentEndpoints();
{{/if}}
{{#if shop}}
app.MapProductEndpoints();
app.MapStoreEndpoints();
{{/if}}
{{#if contact}}
app.MapContactEndpoints();
{{/if}}
{{#if auth}}
app.MapAuthEndpoints();
{{/if}}
app.MapAdminEndpoints();

await DbInitializer.InitializeAsync(app);

{{#if auth}}
// Recovery path for the one-time claim-admin flow (no setup code needed,
 // needs server access): dotnet run -- promote-admin --email owner@shop.com
var promoteIdx = args.ToList().IndexOf("promote-admin");
if (promoteIdx >= 0)
{
    var emailArg = promoteIdx + 1 < args.Length && args[promoteIdx + 1] == "--email" && promoteIdx + 2 < args.Length
        ? args[promoteIdx + 2].Trim().ToLowerInvariant()
        : "";
    if (string.IsNullOrEmpty(emailArg))
    {
        Console.Error.WriteLine("Usage: dotnet run -- promote-admin --email owner@example.com");
        return;
    }
    using var promoteScope = app.Services.CreateScope();
    var promoteDb = promoteScope.ServiceProvider.GetRequiredService<AppDbContext>();
    var promoteUser = await promoteDb.Users.FirstOrDefaultAsync(u => u.Email == emailArg);
    if (promoteUser is null)
    {
        Console.Error.WriteLine($"No account with email \"{emailArg}\".");
        return;
    }
    promoteUser.IsAdmin = true;
    await promoteDb.SaveChangesAsync();
    Console.WriteLine($"\"{emailArg}\" is now a site admin.");
    return;
}
{{/if}}
app.Run();
